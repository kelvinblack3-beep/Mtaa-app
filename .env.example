# Mtaa Application Environment Variables
# Copy to .env and fill in values. NEVER commit real secrets.

# Application
APP_NAME=Mtaa
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=mtaa_session
SESSION_MAX_AGE_SECONDS=86400

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://mtaa:mtaa_dev_password@localhost:5432/mtaa
DATABASE_URL_SYNC=postgresql://mtaa:mtaa_dev_password@localhost:5432/mtaa

# CORS / Frontend
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Auth
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# Daraja / M-Pesa (Sandbox only — never use live credentials here)
DARAJA_MODE=simulation
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=http://localhost:8000/api/v1/payments/mpesa/callback
DARAJA_ENVIRONMENT=sandbox

# Solana (Devnet only — mainnet is rejected by safety guards)
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Never put private keys or seed phrases in env files that are committed.
# Prefer external wallet signing. For local testing only:
# SOLANA_FEE_PAYER_SECRET=  (base58, optional for some ops)

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Admin bootstrap (first admin created via seed or CLI)
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
